{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    // scan-dist-for-eval.test.ts imports scan-dist-for-eval.mjs directly
    // (the check-fixtures.mjs / check-fixtures.test.mjs split this repo
    // already uses at the root) — allowJs lets tsc infer that plain JS
    // module's exported types from its JSDoc, without turning on checkJs
    // (so the .mjs scripts themselves stay un-type-checked, same as
    // scripts/check-fixtures.mjs is today).
    "allowJs": true
  },
  "include": ["src", "scripts", "e2e", "playwright.config.ts", "vite.config.ts"],
  // P07-B's "drive the real bridge" files import @workflow-catalog/runner's
  // server source (an allowed devDependency -- see the P07 packet's
  // allowlist) to start the actual P02 bridge against a temp workspace:
  // the shared harness (e2e/real-bridge-harness.ts), the vitest file that
  // uses it directly (src/shared/bridge-client.realbridge.test.ts), and the
  // Playwright file that drives the real popup/options pages against it
  // (e2e/bridge-e2e.spec.ts). runner/tsconfig.json compiles that source
  // with allowImportingTsExtensions + lib ES2024 (Node 24's native TS type
  // stripping needs the literal .ts extension; runner only ever runs on
  // Node 24), options this package intentionally does not turn on for its
  // own browser-targeted (DOM lib, no .ts-extension imports) source. tsc
  // has one compiler-options set per program, so type-checking these three
  // files here would mean checking the whole imported runner/ graph under
  // this package's options instead of its own -- excluded from tsc rather
  // than loosening this package's options repo-wide. Playwright and Vitest
  // both run them fine regardless (transpile-only, no tsc involved).
  "exclude": ["e2e/real-bridge-harness.ts", "src/shared/bridge-client.realbridge.test.ts", "e2e/bridge-e2e.spec.ts"]
}
