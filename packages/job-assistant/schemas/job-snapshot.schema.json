{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "url": {
      "type": "string",
      "pattern": "^https?:\\/\\/"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "extractorVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8,}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 199998,
      "description": "At most 200000 bytes as UTF-8 JSON: new TextEncoder().encode(JSON.stringify(text)).length, the two quote marks included. JSON Schema cannot express that bound, so maxLength is only a looser code-point limit (every code point serializes to at least 1 byte). The byte bound is enforced exactly by the zod schema in @workflow-catalog/contracts, and on the wire by the bridge's raw 256 KB (262144-byte) request body cap."
    },
    "structured": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "niceToHave": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deadline": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "applyUrl": {
          "type": "string",
          "pattern": "^https?:\\/\\/"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "jobId",
    "revision",
    "url",
    "capturedAt",
    "extractorVersion",
    "contentHash",
    "text",
    "structured"
  ],
  "additionalProperties": false
}
