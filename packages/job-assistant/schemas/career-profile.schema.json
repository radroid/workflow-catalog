{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "metric",
              "title",
              "date",
              "credential"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "disputed",
              "confirmed",
              "excluded"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "resume",
              "previousCoverLetters",
              "portfolioSite",
              "repositories",
              "socialProfiles",
              "workSamples",
              "targetRolesAndPreferences"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "passage",
                  "statement"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "additionalProperties": false
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "status",
          "source",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "resume": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "previousCoverLetters": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "portfolioSite": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "repositories": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "socialProfiles": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "workSamples": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "targetRolesAndPreferences": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "provided",
                "unavailable",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "resume",
        "previousCoverLetters",
        "portfolioSite",
        "repositories",
        "socialProfiles",
        "workSamples",
        "targetRolesAndPreferences"
      ],
      "additionalProperties": false
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
