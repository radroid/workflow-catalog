{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(secrets/**)",
      "Read(keys/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(~/JobAssistant/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(secrets/**)",
      "Edit(keys/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/JobAssistant/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(npx convex deploy:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(gh release create:*)"
    ]
  }
}
