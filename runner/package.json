{
  "name": "@workflow-catalog/runner",
  "version": "0.0.0",
  "private": true,
  "description": "The job-assistant runner: a pinned eve@0.63.0 agent (mode A, eve build + eve start on 127.0.0.1:3210) and the Hono bridge on 127.0.0.1:4310. Used from a whole-repo clone; see README.md.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node --import ./lib/register-ts.mjs cli/setup.ts",
    "doctor": "node --import ./lib/register-ts.mjs cli/doctor.ts",
    "runner": "node --import ./lib/register-ts.mjs cli/runner.ts",
    "pair": "node --import ./lib/register-ts.mjs cli/pair.ts",
    "ui": "node --import ./lib/register-ts.mjs cli/ui.ts",
    "eval": "node --import ./lib/register-ts.mjs cli/eval.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 --ignore-pattern '.eve/**' --ignore-pattern '.output/**' --ignore-pattern '.nitro/**' --ignore-pattern 'eval-agent/.eve/**' --ignore-pattern 'eval-agent/.output/**'",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@workflow-catalog/contracts": "workspace:*",
    "@workflow-catalog/job-assistant-eve": "workspace:*",
    "ai": "7.0.107",
    "eve": "0.63.0",
    "hono": "4.13.8",
    "zod": "4.5.4"
  }
}
